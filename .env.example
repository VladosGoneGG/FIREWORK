# Node-only (Vite dev server) config — deliberately NOT prefixed with VITE_,
# so it is never exposed to client code via import.meta.env or the bundle.
# Used only by vite.config.js to proxy /api to the local Express API.
DEV_API_URL=http://localhost:3000
DEV_API_KEY=change-me

# Client-exposed (fine to be public): Telegram order notifications.
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here
