# Copy to .env and fill in before running `docker compose up -d --build`.
# Assumes the api-salutka repo is checked out as a sibling of this one —
# see the comment in docker-compose.yml.

# Shared secret between the backend and Caddy: the backend requires it as a
# Bearer token on every /api/v1/* request, and Caddy injects it when
# reverse-proxying /api/* — generate a long random value, e.g.:
#   openssl rand -hex 32
API_KEY=

# Domain Caddy requests its Let's Encrypt certificate for. Must already
# resolve (A/AAAA record) to this VPS before you start the stack.
DOMAIN=salutxprime.ru

# Optional: order notifications. Baked into the frontend bundle at build
# time, so changing these requires `docker compose up -d --build web`.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
